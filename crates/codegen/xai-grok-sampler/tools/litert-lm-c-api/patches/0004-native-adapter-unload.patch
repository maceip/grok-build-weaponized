diff --git a/c/engine.cc b/c/engine.cc
--- a/c/engine.cc
+++ b/c/engine.cc
@@ -466,5 +466,31 @@ LiteRtLmEngine* litert_lm_engine_create(

 void litert_lm_engine_delete(LiteRtLmEngine* engine) { delete engine; }

+int grok_litert_engine_unload_lora(
+    LiteRtLmEngine* engine, const char* identity,
+    const char** error_message) {
+  g_grok_last_error.clear();
+  if (error_message != nullptr) {
+    *error_message = nullptr;
+  }
+  if (engine == nullptr || engine->engine == nullptr || identity == nullptr ||
+      identity[0] == '\0') {
+    g_grok_last_error = "invalid engine or empty LoRA identity";
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 1;
+  }
+  absl::Status status = engine->engine->UnloadLoRA(identity);
+  if (!status.ok()) {
+    SetGrokLastError(status);
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 2;
+  }
+  return 0;
+}
