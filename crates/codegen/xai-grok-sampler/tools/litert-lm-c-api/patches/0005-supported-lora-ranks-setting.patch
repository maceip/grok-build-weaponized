+int grok_litert_engine_settings_set_supported_lora_ranks(
+    LiteRtLmEngineSettings* settings, const uint32_t* ranks, size_t num_ranks,
+    const char** error_message) {
+  g_grok_last_error.clear();
+  if (error_message != nullptr) {
+    *error_message = nullptr;
+  }
+  if (settings == nullptr || settings->settings == nullptr ||
+      (num_ranks > 0 && ranks == nullptr)) {
+    g_grok_last_error = "invalid supported LoRA rank arguments";
+  } else {
+    std::vector<uint32_t> supported_ranks;
+    supported_ranks.reserve(num_ranks);
+    for (size_t index = 0; index < num_ranks; ++index) {
+      if (ranks[index] == 0) {
+        g_grok_last_error = "supported LoRA ranks must be non-zero";
+        break;
+      }
+      supported_ranks.push_back(ranks[index]);
+    }
+    if (g_grok_last_error.empty()) {
+      auto& executor_settings =
+          settings->settings->GetMutableMainExecutorSettings();
+      auto artisan_config =
+          executor_settings.GetBackendConfig<litert::lm::GpuArtisanConfig>();
+      if (artisan_config.ok()) {
+        auto status = executor_settings.SetSupportedLoraRanks(supported_ranks);
+        if (status.ok()) {
+          return 0;
+        }
+        SetGrokLastError(status);
+      } else if (executor_settings
+                     .GetBackendConfig<litert::lm::GpuConfig>()
+                     .ok()) {
+        // The compiled-model GPU executor discovers LoRA inputs directly from
+        // the model. Rust enforces this declared set before load; native
+        // materialization and probe generation validate the actual tensors.
+        return 0;
+      } else {
+        g_grok_last_error =
+            "supported LoRA ranks require a LiteRT GPU backend";
+      }
+    }
+  }
+  if (error_message != nullptr) {
+    *error_message = g_grok_last_error.c_str();
+  }
+  return 1;
+}
