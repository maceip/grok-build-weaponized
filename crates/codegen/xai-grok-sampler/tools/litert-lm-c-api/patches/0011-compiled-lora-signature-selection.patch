diff --git a/runtime/executor/llm_litert_compiled_model_executor.cc b/runtime/executor/llm_litert_compiled_model_executor.cc
index c54b7604..9834ed89 100644
--- a/runtime/executor/llm_litert_compiled_model_executor.cc
+++ b/runtime/executor/llm_litert_compiled_model_executor.cc
@@ -82,6 +82,75 @@ constexpr absl::string_view kPrefillSignatureRunner = "prefill";
 constexpr absl::string_view kDecodeSignatureRunner = "decode";
 constexpr int kDynamicDimValue = -1;

+struct SelectedCompiledSignatures {
+  std::string decode_key;
+  std::string prefill_suffix;
+};
+
+absl::StatusOr<SelectedCompiledSignatures> SelectCompiledSignatures(
+    const Model& model, uint32_t lora_rank) {
+  if (lora_rank == 0) {
+    return SelectedCompiledSignatures{std::string(kDecodeSignatureRunner), ""};
+  }
+  const std::string suffix = absl::StrCat("_lora_r", lora_rank);
+  const std::string candidate =
+      absl::StrCat(kDecodeSignatureRunner, suffix);
+  for (int index = 0; index < model.GetNumSignatures(); ++index) {
+    LITERT_ASSIGN_OR_RETURN(auto signature, model.GetSignature(index));
+    if (signature.Key() == candidate) {
+      return SelectedCompiledSignatures{candidate, suffix};
+    }
+  }
+  // Some compiled artifacts expose LoRA tensors directly on the canonical
+  // decode/prefill signatures. Preserve compatibility with those artifacts;
+  // LoraManager rejects the model later if the canonical signatures do not
+  // actually contain LoRA inputs.
+  return SelectedCompiledSignatures{std::string(kDecodeSignatureRunner), ""};
+}
+
+bool MatchesSelectedPrefillSignature(absl::string_view key,
+                                     absl::string_view lora_suffix) {
+  if (!absl::StartsWith(key, kPrefillSignatureRunner)) {
+    return false;
+  }
+  if (lora_suffix.empty()) {
+    return !absl::StrContains(key, "_lora_r");
+  }
+  return absl::EndsWith(key, lora_suffix);
+}
+
+absl::StatusOr<SortedPrefillSignatureMap> GetSelectedPrefillRunnerSet(
+    const Model& model, absl::string_view lora_suffix,
+    absl::string_view input_positions_name) {
+  SortedPrefillSignatureMap runners;
+  for (int index = 0; index < model.GetNumSignatures(); ++index) {
+    LITERT_ASSIGN_OR_RETURN(auto signature, model.GetSignature(index));
+    if (!MatchesSelectedPrefillSignature(signature.Key(), lora_suffix)) {
+      continue;
+    }
+    LITERT_ASSIGN_OR_RETURN(
+        auto input_positions_tensor,
+        signature.InputTensor(input_positions_name));
+    LITERT_ASSIGN_OR_RETURN(auto ranked_tensor_type,
+                            input_positions_tensor.RankedTensorType());
+    const auto dimensions = ranked_tensor_type.Layout().Dimensions();
+    if (ranked_tensor_type.Layout().Rank() == 2) {
+      runners[dimensions[1]] = std::string(signature.Key());
+    } else if (ranked_tensor_type.Layout().Rank() == 1) {
+      runners[dimensions[0]] = std::string(signature.Key());
+    } else {
+      return absl::FailedPreconditionError(
+          "Unsupported input positions tensor dimension.");
+    }
+  }
+  if (runners.empty()) {
+    return absl::FailedPreconditionError(absl::StrCat(
+        "No prefill signature matches selected LoRA suffix '", lora_suffix,
+        "'."));
+  }
+  return runners;
+}
