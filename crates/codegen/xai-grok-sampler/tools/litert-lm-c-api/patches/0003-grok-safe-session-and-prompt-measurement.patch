+int grok_litert_session_config_set_lora_file(
+    LiteRtLmSessionConfig* config, const char* path, const char* identity,
+    const char** error_message) {
+  if (error_message != nullptr) {
+    *error_message = nullptr;
+  }
+  if (config == nullptr || config->config == nullptr || path == nullptr ||
+      path[0] == '\0' || identity == nullptr || identity[0] == '\0') {
+    g_grok_last_error =
+        "invalid session config or empty LoRA path/identity";
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 1;
+  }
+
+  auto scoped_file = litert::lm::ScopedFile::Open(path);
+  if (!scoped_file.ok()) {
+    SetGrokLastError(scoped_file.status());
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 2;
+  }
+  config->config->SetScopedLoraFile(
+      std::make_shared<litert::lm::ScopedFile>(
+          std::move(scoped_file).value()));
+  config->config->SetLoraIdentity(identity);
+  return 0;
+}
