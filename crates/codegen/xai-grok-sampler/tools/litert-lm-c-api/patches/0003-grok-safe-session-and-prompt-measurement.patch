+int grok_litert_conversation_measure_prompt(
+    LiteRtLmEngine* engine, LiteRtLmConversationConfig* config,
+    const char* message_json, size_t* token_count,
+    const char** error_message) {
+  g_grok_last_error.clear();
+  if (error_message != nullptr) {
+    *error_message = nullptr;
+  }
+  if (engine == nullptr || engine->engine == nullptr || config == nullptr ||
+      message_json == nullptr || token_count == nullptr) {
+    g_grok_last_error = "invalid prompt measurement arguments";
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 1;
+  }
+
+  litert::lm::JsonPreface json_preface;
+  if (!config->system_message_json.empty()) {
+    nlohmann::ordered_json system_message;
+    system_message["role"] = "system";
+    auto content = nlohmann::ordered_json::parse(
+        config->system_message_json, nullptr, false);
+    system_message["content"] =
+        content.is_discarded()
+            ? nlohmann::ordered_json(config->system_message_json)
+            : std::move(content);
+    json_preface.messages = nlohmann::ordered_json::array({system_message});
+  }
+  if (!config->messages_json.empty()) {
+    auto messages = nlohmann::ordered_json::parse(config->messages_json,
+                                                  nullptr, false);
+    if (messages.is_discarded() || !messages.is_array()) {
+      g_grok_last_error = "failed to parse measurement history JSON";
+      if (error_message != nullptr) {
+        *error_message = g_grok_last_error.c_str();
+      }
+      return 2;
+    }
+    if (json_preface.messages.is_array()) {
+      json_preface.messages.insert(json_preface.messages.end(),
+                                   messages.begin(), messages.end());
+    } else {
+      json_preface.messages = std::move(messages);
+    }
+  }
+  if (!config->tools_json.empty()) {
+    auto tools = nlohmann::ordered_json::parse(config->tools_json, nullptr,
+                                               false);
+    if (tools.is_discarded() || !tools.is_array()) {
+      g_grok_last_error = "failed to parse measurement tools JSON";
+      if (error_message != nullptr) {
+        *error_message = g_grok_last_error.c_str();
+      }
+      return 3;
+    }
+    json_preface.tools = std::move(tools);
+  }
+  auto builder = litert::lm::ConversationConfig::Builder();
+  if (config->session_config.has_value()) {
+    builder.SetSessionConfig(*config->session_config);
+  }
+  builder.SetPreface(json_preface);
+  builder.SetEnableConstrainedDecoding(config->enable_constrained_decoding);
+  auto native_config = builder.Build(*engine->engine);
+  if (!native_config.ok()) {
+    SetGrokLastError(native_config.status());
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 4;
+  }
+
+  nlohmann::json message = nlohmann::json::parse(
+      message_json, /*cb=*/nullptr, /*allow_exceptions=*/false);
+  if (message.is_discarded()) {
+    g_grok_last_error = "failed to parse measurement message JSON";
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 5;
+  }
+  auto rendered = litert::lm::Conversation::RenderMessageWithoutSession(
+      *engine->engine, *native_config, message, {});
+  if (!rendered.ok()) {
+    SetGrokLastError(rendered.status());
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 6;
+  }
+  auto tokens = const_cast<litert::lm::Tokenizer&>(
+      engine->engine->GetTokenizer()).TextToTokenIds(*rendered);
+  if (!tokens.ok()) {
+    SetGrokLastError(tokens.status());
+    if (error_message != nullptr) {
+      *error_message = g_grok_last_error.c_str();
+    }
+    return 7;
+  }
+  *token_count = tokens->size();
+  return 0;
+}
